# Pour lancer le backend hors Docker (flask run), avec les services de docker compose.
# ./run.sh crée ce fichier automatiquement avec les bons secrets.
DATABASE_URL=postgresql+psycopg://app:change-me-postgres@localhost:5432/potentiel
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=potentiel
S3_SECRET_KEY=change-me-s3
S3_BUCKET=conversations
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
JWT_SECRET_KEY=change-me-jwt
CORS_ORIGINS=http://localhost:5173
