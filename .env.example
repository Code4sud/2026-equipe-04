# ./run.sh copie ce fichier vers .env et remplace chaque « change-me » par un secret aléatoire.

# Services lancés par défaut. Videz cette valeur pour utiliser un Ollama installé sur la machine.
COMPOSE_PROFILES=ollama

# Adresse d'écoute sur la machine. 0.0.0.0 ouvre tous les services au réseau local.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=5001
POSTGRES_PORT=5432
S3_PORT=8333
OLLAMA_PORT=11435

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=potentiel
DATABASE_URL=postgresql+psycopg://app:change-me-postgres@postgres:5432/potentiel

# Stockage des conversations (SeaweedFS, API S3)
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=potentiel
S3_SECRET_KEY=change-me-s3
S3_BUCKET=conversations

# Modèle de langue
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral-nemo
# Embeddings locaux pour rapprocher le récit du référentiel de compétences (vide = désactivé)
OLLAMA_EMBED_MODEL=bge-m3

# Backend
JWT_SECRET_KEY=change-me-jwt
CORS_ORIGINS=

# Frontend : /api passe par le proxy nginx du conteneur
VITE_API_URL=/api

# Comptes de démonstration, avec des données fictives
SEED_DEMO=true
SEED_PSY_EMAIL=psy@example.org
SEED_PSY_PASSWORD=change-me-psy
SEED_YOUTH_EMAIL=sam@example.org
SEED_YOUTH_PASSWORD=change-me-jeune
